# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a; source .env; set +a          # export every name defined below
#   python scripts/check_provider.py
#
# Phase 1's only live-provider consumer is
# tests/test_openai_compat.py::test_against_a_real_provider. It reads these three
# variables and skips unless all three are set, so leaving them blank keeps
# `pytest -m integration` green rather than red.

XWALK_TEST_API_KEY=
XWALK_TEST_BASE_URL=
XWALK_TEST_MODEL=

# Optional. One of: openai, anthropic-compat, google-compat, vllm, unknown.
# Decides only what xwalk *asks* a provider for; every response is validated
# regardless of what the profile claims.
# XWALK_TEST_PROFILE=openai

# ---- endpoint presets --------------------------------------------------------
# OpenRouter  https://openrouter.ai/api/v1                                openai/gpt-4o-mini
# OpenAI      https://api.openai.com/v1                                   gpt-4o-mini
# Gemini      https://generativelanguage.googleapis.com/v1beta/openai     gemini-2.0-flash
# vLLM local  http://127.0.0.1:8000/v1                                    <your --model>
