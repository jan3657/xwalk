  <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_10015">
    <rdfs:label>vobasine</rdfs:label>
    <obo:IAO_0000115>An indole alkaloid that is vobasan in which the bridgehead methyl group is substituted by a methoxycarbonyl group and an additional oxo substituent is present in the 3-position.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>Vobasine</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>methyl 3-oxovobasan-17-oate</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>3-oxovobasan-17-oic acid, methyl ester</oboInOwl:hasExactSynonym>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25248"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38163"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38481"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_38958"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_3992"/>
  </owl:Class>
