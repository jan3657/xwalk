  <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_101064">
    <rdfs:label>Ro 48-8071</rdfs:label>
    <obo:IAO_0000115>An aromatic ketone that is 2-fluoro-4'-bromobenzophenone in which the hydrogen at position 4 (meta to the fluoro group) is replaced by a 6-[methyl(prop-2-en-1-yl)amino]hexyl}oxy group. An inhibitor of lanosterol synthase.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>(4-bromophenyl)[2-fluoro-4-({6-[methyl(prop-2-en-1-yl)amino]hexyl}oxy)phenyl]methanone</oboInOwl:hasExactSynonym>
