  </owl:Class>
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03420108">
    <rdfs:label>sugar</rdfs:label>
    <obo:IAO_0000115>A broad term that includes the nutritive sweeteners dextrose, fructose, galactose, lactose, maltose and sucrose, which are simple carbohydrates with molecules composed of one or two saccharide units. Note that on a product label or in a recipe, 'sugar' means *SUCROSE* and should be so indexed. Use the broad term *SUGAR* only if the specific sugar used is not known or not listed in the vocabulary.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03420152"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03420156">
    <rdfs:label>brown sugar</rdfs:label>
    <obo:IAO_0000115>Soft sugar whose crystals are covered by a film of refined dark syrup that imparts color, flavor, and moisture.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001083"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03301073"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03420157">
    <rdfs:label>white sugar</rdfs:label>
    <obo:IAO_0000115>White sugar is highly refined crystalline sugar, mostly sucrose, that appears white in color.  White sugar is commonly used in North America and Europe, made either of beet sugar or cane sugar, that has undergone a refining process which removes molasses.</obo:IAO_0000115>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001083"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_03301073"/>
  </owl:Class>
</rdf:RDF>
