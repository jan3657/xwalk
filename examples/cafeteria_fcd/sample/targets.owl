    <obo:IAO_0000115>Food material which has its flavour or taste enhanced by some process which may include the addition of flavourings.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>flavoured</oboInOwl:hasExactSynonym>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00002645"/>
  </owl:Class>
