  <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_03316764">
    <rdfs:label>vanilla bean extract</rdfs:label>
    <obo:IAO_0000115>Vanilla extract is a solution containing the flavor compound vanillin as the primary ingredient.  It is made by macerating and percolating vanilla pods in a solution of ethanol and water.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>natural vanilla</oboInOwl:hasExactSynonym>
