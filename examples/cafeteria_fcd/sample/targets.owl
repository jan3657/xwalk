    <rdfs:label>liquid chemical food component</rdfs:label>
    <obo:IAO_0000115>A chemical food component in liquid form.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>Liquid as food source</oboInOwl:hasExactSynonym>
